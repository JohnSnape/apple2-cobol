 IDENTIFICATION DIVISION.
 PROGRAM-ID. FCHK.
 ENVIRONMENT DIVISION.
 INPUT-OUTPUT SECTION.
 FILE-CONTROL.
     SELECT TF ASSIGN TO "FCHK.DAT"
         ORGANIZATION IS RELATIVE
         ACCESS MODE IS DYNAMIC
         RELATIVE KEY IS TK
         FILE STATUS IS TS.
 DATA DIVISION.
 FILE SECTION.
 FD  TF
     LABEL RECORDS ARE STANDARD
     RECORD CONTAINS 10 CHARACTERS
     BLOCK CONTAINS 1 RECORDS
     DATA RECORD IS TR.
 01  TR.
     05  TR-A        PIC X(10).
 WORKING-STORAGE SECTION.
 01  TK          PIC 9(4) COMP.
 01  TS          PIC XX.
 01  N           PIC 9(2) VALUE ZERO.
 01  WS-EOF      PIC X VALUE "N".
 PROCEDURE DIVISION.
 MAIN-PARA.
     OPEN OUTPUT TF.
     MOVE 1 TO TK. MOVE "AAA" TO TR-A. WRITE TR.
     MOVE 2 TO TK. MOVE "BBB" TO TR-A. WRITE TR.
     MOVE 3 TO TK. MOVE "CCC" TO TR-A. WRITE TR.
     CLOSE TF.
     OPEN I-O TF.
     MOVE 2 TO TK.
     DELETE TF.
     CLOSE TF.
     OPEN INPUT TF.
     PERFORM UNTIL WS-EOF = "Y"
         READ TF NEXT RECORD
             AT END MOVE "Y" TO WS-EOF
         END-READ
         IF WS-EOF = "N"
             ADD 1 TO N
             DISPLAY "R " TR-A
         END-IF
     END-PERFORM.
     DISPLAY "T1 " N " " TS.
     MOVE 9 TO TK.
     READ TF INVALID KEY DISPLAY "T2 OK " TS
     END-READ.
     MOVE 1 TO TK.
     READ TF INVALID KEY DISPLAY "T3 FAIL"
     END-READ.
     DISPLAY "T3 " TS " " TR-A.
     CLOSE TF.
     OPEN I-O TF.
     MOVE 2 TO TK.
     MOVE "ZZZ" TO TR-A.
     REWRITE TR INVALID KEY DISPLAY "T4 OK " TS
     END-REWRITE.
     MOVE 2 TO TK.
     DELETE TF INVALID KEY DISPLAY "T5 OK " TS
     END-DELETE.
     MOVE 3 TO TK.
     DELETE TF INVALID KEY DISPLAY "T6 FAIL"
     END-DELETE.
     DISPLAY "T6 " TS.
     CLOSE TF.
     DISPLAY "DONE".
     STOP RUN.
