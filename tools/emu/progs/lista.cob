 IDENTIFICATION DIVISION.
 PROGRAM-ID. LISTA.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01  BAL   PIC 9(5)V99.
 01  N     PIC 9(3).
 01  R     PIC 9(5)V99.
 01  Q     PIC 9(5)V99.
 01  X     PIC 9(3).
 PROCEDURE DIVISION.
 MAIN-PARA.
     MOVE 50 TO BAL.
     IF BAL > 100 DISPLAY "A3 FAIL" ELSE DISPLAY "A3 OK".
     MOVE 100 TO N.
     IF BAL < N DISPLAY "A3B OK" ELSE DISPLAY "A3B FAIL".
     IF BAL < 50.5 DISPLAY "A3C OK" ELSE DISPLAY "A3C FAIL".
     IF NOT BAL = 50 DISPLAY "A5 FAIL" ELSE DISPLAY "A5 OK".
     COMPUTE X = 2 + 3
     DISPLAY "A6 " X.
     COMPUTE R = 1 + 0.5.
     DISPLAY "A7A " R.
     COMPUTE Q = 10 / 2.50.
     DISPLAY "A7B " Q.
     COMPUTE Q = 10 / 4.
     DISPLAY "A7C " Q.
     ADD 1.5 TO R.
     DISPLAY "A7D " R.
     MOVE 10 TO N.
     DIVIDE N BY 4 GIVING Q.
     DISPLAY "A8A " Q.
     DIVIDE 4 INTO N GIVING Q.
     DISPLAY "A8B " Q.
     MOVE 0 TO X.
     COMPUTE Q = 1 / X.
     DISPLAY "A7E FAIL".
     STOP RUN.
