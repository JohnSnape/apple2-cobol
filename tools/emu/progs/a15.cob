 IDENTIFICATION DIVISION.
 PROGRAM-ID. A15.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01  A  PIC 9(3)V99.
 01  B  PIC 9(3)V9.
 01  C  PIC 9(3)V9.
 01  D  PIC 9(3).
 01  E  PIC 9(3)V99.
 01  S  PIC S9(3)V9.
 PROCEDURE DIVISION.
 MAIN-PARA.
     MOVE 0.05 TO E. MOVE 1 TO B.
     ADD E TO B ROUNDED.
     DISPLAY "R1 1.1  " B.
     MOVE 1.06 TO A.
     ADD E TO A GIVING C.
     DISPLAY "R2 1.1  " C.
     COMPUTE D ROUNDED = 10 / 4.
     DISPLAY "R3 3    " D.
     COMPUTE D = 10 / 4.
     DISPLAY "R4 2    " D.
     MOVE 3 TO D.
     MULTIPLY 1.5 BY D ROUNDED.
     DISPLAY "R5 5    " D.
     DIVIDE 3 INTO 2 GIVING B ROUNDED.
     DISPLAY "R6 0.7  " B.
     MOVE 0 TO S. MOVE 0.25 TO E.
     SUBTRACT E FROM S ROUNDED.
     DISPLAY "R7 -0.3 " S.
     COMPUTE D ROUNDED = 2.4.
     DISPLAY "R8 2    " D.
     MOVE 0.05 TO E. MOVE 1 TO B.
     ADD E TO B.
     DISPLAY "R9 1.0  " B.
     MOVE 2 TO D.
     MULTIPLY 1.5 BY D GIVING B.
     DISPLAY "RA 3.0  " B.
     DIVIDE D BY 4 GIVING B ROUNDED.
     DISPLAY "RB 0.5  " B.
     COMPUTE B ROUNDED = 2 / 3.
     DISPLAY "RC 0.7  " B.
     STOP RUN.
