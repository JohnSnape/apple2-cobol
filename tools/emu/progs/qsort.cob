 IDENTIFICATION DIVISION.
 PROGRAM-ID. QSORT.
 ENVIRONMENT DIVISION.
 CONFIGURATION SECTION.
 SPECIAL-NAMES.
     QUERY STATUS IS WS-QSTAT.
 INPUT-OUTPUT SECTION.
 FILE-CONTROL.
     SELECT CUST-FILE ASSIGN TO "CUST.DAT"
         ORGANIZATION IS RELATIVE
         ACCESS MODE IS DYNAMIC
         RELATIVE KEY IS CUST-KEY
         FILE STATUS IS FILE-STAT.
 DATA DIVISION.
 FILE SECTION.
 FD  CUST-FILE.
 01  CUST-REC.
     05  CUST-NAME   PIC X(20).
     05  CUST-BAL    PIC 9(8).
 WORKING-STORAGE SECTION.
 01  CUST-KEY    PIC 9(4) COMP.
 01  FILE-STAT   PIC XX.
 01  WS-QSTAT    PIC 99.
 01  WS-HITS     PIC 9(4).
 01  WS-REC      PIC 9(4).
 01  WS-BAL      PIC 9(8).
 01  WS-EOF      PIC X VALUE "N".
 PROCEDURE DIVISION.
 MAIN-PARA.
     OPEN INPUT CUST-FILE.
     QUERY "BALDESC" USING "CUST" OF CUST-FILE
         GIVING WS-HITS
         ON ERROR DISPLAY "E1 " WS-QSTAT.
     DISPLAY "A " WS-QSTAT " " WS-HITS.
     PERFORM UNTIL WS-EOF = "Y"
         QUERY NEXT GIVING WS-REC AT END MOVE "Y" TO WS-EOF
         IF WS-EOF = "N"
             MOVE WS-REC TO CUST-KEY
             READ CUST-FILE
             QUERY FIELD 1 INTO WS-BAL
             DISPLAY WS-REC " " CUST-NAME " " WS-BAL
         END-IF
     END-PERFORM.
     CLOSE CUST-FILE.
     STOP RUN.
