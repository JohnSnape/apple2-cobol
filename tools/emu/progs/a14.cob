 IDENTIFICATION DIVISION.
 PROGRAM-ID. A14.
 ENVIRONMENT DIVISION.
 INPUT-OUTPUT SECTION.
 FILE-CONTROL.
     SELECT TF ASSIGN TO "T14.DAT"
         ORGANIZATION IS RELATIVE
         ACCESS MODE IS DYNAMIC
         RELATIVE KEY IS TK
         FILE STATUS IS TS.
 DATA DIVISION.
 FILE SECTION.
 FD  TF.
 01  TR.
     05  TR-A PIC X(10).
 WORKING-STORAGE SECTION.
 01  TK PIC 9(4).
 01  TS PIC XX.
 01  N  PIC 9(3).
 PROCEDURE DIVISION.
 MAIN.
     OPEN OUTPUT TF.
     MOVE 1 TO TK. MOVE "ONE" TO TR-A. WRITE TR.
     MOVE 2 TO TK. MOVE "TWO" TO TR-A. WRITE TR.
     CLOSE TF.
     OPEN INPUT TF.
     MOVE 1 TO TK.
     READ TF INVALID KEY
         IF TK = 1 DISPLAY "T1 FAIL" ELSE DISPLAY "T1 FAIL2"
         END-IF
     END-READ.
     DISPLAY "T1 OK " TR-A.
     MOVE 9 TO TK.
     READ TF INVALID KEY
         IF TK = 9 DISPLAY "T2 OK" ELSE DISPLAY "T2 FAIL"
         END-IF
     END-READ.
     MOVE 8 TO TK.
     READ TF INVALID KEY
         READ TF INVALID KEY DISPLAY "T3 OK"
     END-READ.
     DISPLAY "T3 AFTER".
     MOVE 2 TO TK.
     READ TF INVALID KEY
         READ TF INVALID KEY DISPLAY "T4 FAIL"
     END-READ.
     DISPLAY "T4 OK " TR-A.
     MOVE 7 TO TK.
     MOVE 0 TO N.
     READ TF INVALID KEY IF N = 0 DISPLAY "T5 OK"
         ELSE DISPLAY "T5 FAIL".
     DISPLAY "T5 AFTER".
     MOVE 1 TO TK.
     READ TF INVALID KEY IF N = 0 DISPLAY "T6 FAIL".
     DISPLAY "T6 OK".
     IF N = 0 READ TF INVALID KEY DISPLAY "T7 FAIL" END-READ
         DISPLAY "T7 OK" ELSE DISPLAY "T7 BAD".
     MOVE 6 TO TK.
     READ TF INVALID KEY
         PERFORM UNTIL N > 2 ADD 1 TO N END-PERFORM.
     DISPLAY "T8 " N.
     CLOSE TF.
     STOP RUN.
