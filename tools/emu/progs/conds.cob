 IDENTIFICATION DIVISION.
 PROGRAM-ID. CONDS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 A PIC 9.
 01 B PIC 9.
 01 F PIC X VALUE "N".
     88 F-YES VALUE "Y".
 PROCEDURE DIVISION.
 MAIN.
     MOVE 1 TO A.
     MOVE 2 TO B.
     IF A = 1 AND B = 2 DISPLAY "T1 OK" ELSE DISPLAY "T1 BAD"
     END-IF.
     IF A = 1 AND B = 3 DISPLAY "T2 BAD" ELSE DISPLAY "T2 OK"
     END-IF.
     IF A = 2 OR B = 2 DISPLAY "T3 OK" ELSE DISPLAY "T3 BAD"
     END-IF.
     IF A = 2 OR B = 3 DISPLAY "T4 BAD" ELSE DISPLAY "T4 OK"
     END-IF.
     IF A = 1 AND B = 2 AND A < B DISPLAY "T5 OK"
     ELSE DISPLAY "T5 BAD"
     END-IF.
     IF A = 3 OR B = 3 OR A = 1 DISPLAY "T6 OK"
     ELSE DISPLAY "T6 BAD"
     END-IF.
     MOVE 0 TO A.
     PERFORM UNTIL A > 3 OR B = 9
         ADD 1 TO A
     END-PERFORM.
     DISPLAY "T7 " A " (4)".
     MOVE 0 TO A.
     PERFORM UNTIL A > 3 AND B = 2
         ADD 1 TO A
     END-PERFORM.
     DISPLAY "T8 " A " (4)".
     EVALUATE TRUE
         WHEN A = 4 AND B = 2 DISPLAY "T9 OK"
         WHEN OTHER DISPLAY "T9 BAD"
     END-EVALUATE.
     MOVE 0 TO A.
     IF A = ZERO DISPLAY "T10 OK" ELSE DISPLAY "T10 BAD"
     END-IF.
     IF NOT F-YES AND B = 2 DISPLAY "T11 OK"
     ELSE DISPLAY "T11 BAD"
     END-IF.
     MOVE "Y" TO F.
     IF F-YES DISPLAY "T12 OK" ELSE DISPLAY "T12 BAD"
     END-IF.
     STOP RUN.
