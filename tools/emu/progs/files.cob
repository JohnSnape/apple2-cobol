 IDENTIFICATION DIVISION.
 PROGRAM-ID. FILES.
 ENVIRONMENT DIVISION.
 INPUT-OUTPUT SECTION.
 FILE-CONTROL.
     SELECT TF ASSIGN TO "T.DAT"
         ORGANIZATION IS RELATIVE
         ACCESS MODE IS DYNAMIC
         RELATIVE KEY IS TK
         FILE STATUS IS TS.
 DATA DIVISION.
 FILE SECTION.
 FD  TF.
 01  TR.
     05  TR-A PIC X(10).
 WORKING-STORAGE SECTION.
 01  TK PIC 9(4).
 01  TS PIC XX.
 PROCEDURE DIVISION.
 MAIN.
     OPEN OUTPUT TF.
     DISPLAY "OPEN  " TS.
     MOVE 1 TO TK.
     MOVE "HELLO" TO TR-A.
     WRITE TR INVALID KEY DISPLAY "BAD WRITE"
     END-WRITE.
     DISPLAY "WRITE " TS.
     CLOSE TF.
     DISPLAY "CLOSE " TS.
     OPEN INPUT TF.
     DISPLAY "OPEN2 " TS.
     MOVE 1 TO TK.
     MOVE SPACES TO TR-A.
     READ TF INVALID KEY DISPLAY "BAD READ"
     END-READ.
     DISPLAY "READ  " TS " " TR-A.
     CLOSE TF.
     STOP RUN.
